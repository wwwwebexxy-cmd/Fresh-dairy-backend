# Copy this file to .env and replace the placeholders locally or on the server.
# Never commit .env or paste SMTP credentials into source control.

DEBUG=False
SECRET_KEY=replace-with-a-new-secret
ALLOWED_HOSTS=your-api-domain.example

DB_NAME=replace-with-new-database-name
DB_USER=replace-with-new-database-user
DB_PASSWORD=replace-with-new-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

SITE_URL=https://your-storefront-domain.example
STOREFRONT_ORIGINS=https://your-storefront-domain.example

# Mailtrap SMTP. Use the SMTP credentials shown in your Mailtrap inbox.
EMAIL_PROVIDER=mailtrap
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=replace-with-mailtrap-smtp-username
MAILTRAP_SMTP_PASSWORD=replace-with-mailtrap-smtp-password
MAILTRAP_FROM_EMAIL=no-reply@your-storefront-domain.example
EMAIL_TIMEOUT=20

# Optional owner notification recipient for new orders.
ORDER_NOTIFICATION_EMAIL=
