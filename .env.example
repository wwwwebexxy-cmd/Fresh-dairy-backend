# Copy to .env and replace placeholders with newly created local values.
# Do not put production credentials or an existing database connection here.
FRESH_DAIRY_DEBUG=True
FRESH_DAIRY_SECRET_KEY=replace-with-a-new-local-secret
FRESH_DAIRY_ALLOWED_HOSTS=localhost,127.0.0.1

# Use a newly created, empty local database.
FRESH_DAIRY_DB_NAME=fresh_dairy_dev
FRESH_DAIRY_DB_USER=fresh_dairy_dev
FRESH_DAIRY_DB_PASSWORD=replace-with-a-new-local-password
FRESH_DAIRY_DB_HOST=127.0.0.1
FRESH_DAIRY_DB_PORT=3306

FRESH_DAIRY_SITE_URL=http://localhost:5173
FRESH_DAIRY_STOREFRONT_ORIGINS=http://localhost:5173
FRESH_DAIRY_JWT_COOKIE_DOMAIN=
FRESH_DAIRY_JWT_COOKIE_SAMESITE=Lax

# Local mail is printed to the console. Configure a new provider only when needed.
FRESH_DAIRY_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRESH_DAIRY_EMAIL_PROVIDER=smtp
FRESH_DAIRY_EMAIL_HOST=localhost
FRESH_DAIRY_EMAIL_PORT=1025
FRESH_DAIRY_EMAIL_USE_TLS=false
FRESH_DAIRY_EMAIL_USE_SSL=false
FRESH_DAIRY_EMAIL_HOST_USER=
FRESH_DAIRY_EMAIL_HOST_PASSWORD=
FRESH_DAIRY_DEFAULT_FROM_EMAIL=no-reply@fresh-dairy.test
FRESH_DAIRY_ORDER_NOTIFICATION_EMAIL=

# Integrations are disabled until newly issued credentials are supplied.
FRESH_DAIRY_CASHFREE_ENABLED=false
FRESH_DAIRY_CASHFREE_ENV=sandbox
FRESH_DAIRY_CASHFREE_CLIENT_ID=
FRESH_DAIRY_CASHFREE_CLIENT_SECRET=
FRESH_DAIRY_CASHFREE_WEBHOOK_URL=
FRESH_DAIRY_STRIPE_PUBLISHABLE_KEY=
FRESH_DAIRY_STRIPE_SECRET_KEY=
FRESH_DAIRY_STRIPE_WEBHOOK_SECRET=
FRESH_DAIRY_GOOGLE_CLIENT_ID=
FRESH_DAIRY_WHATSAPP_ACCESS_TOKEN=
FRESH_DAIRY_WHATSAPP_PHONE_NUMBER_ID=
FRESH_DAIRY_WHATSAPP_OWNER_PHONE=